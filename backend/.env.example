# Copy to .env and fill in real values.

# Firebase Admin SDK — path to service account JSON, or the JSON string itself.
# Download from Firebase Console → Project settings → Service accounts.
FIREBASE_CREDENTIALS_JSON=./firebase-service-account.json
# Optional; usually inferred from the credentials file.
# FIREBASE_PROJECT_ID=your-firebase-project-id

# Cloudflare Turnstile (CAPTCHA for admin + web password login).
# Empty = disabled. Pair with cloudflareTurnstileSiteKey in Angular environments.
# CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Stripe (Direct Charges + Connect Express)
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# Platform webhook secret → /api/v1/checkout/stripe-webhook
# STRIPE_WEBHOOK_SECRET=whsec_...
# Connect webhook secret → /api/v1/checkout/stripe-connect-webhook
# STRIPE_CONNECT_WEBHOOK_SECRET=whsec_...
# PLATFORM_FEE_PERCENTAGE=0.07
#
# En servidor de pruebas/producción NO uses localhost (Stripe redirige aquí tras onboarding):
# FRONTEND_URL=https://buymeashake.fit
# STRIPE_CONNECT_RETURN_URL=https://buymeashake.fit/dashboard/payouts?status=return
# STRIPE_CONNECT_REFRESH_URL=https://buymeashake.fit/dashboard/payouts?status=refresh
